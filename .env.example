# PostgreSQL — matches docker-compose.yml (port 5433 to avoid clashing with a local install)
DATABASE_URL="postgresql://shecare:shecare@localhost:5433/shecare?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me"

# Appointment slots are computed in this timezone
TZ="Africa/Algiers"
