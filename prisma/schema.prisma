generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Accounts ────────────────────────────────────────────────────────────────

enum Role {
  PATIENT
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  birthDate    DateTime?
  location     String?
  bio          String?
  role         Role      @default(PATIENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  medical      MedicalProfile?
  preferences  Preferences?
  dailyLogs    DailyLog[]
  symptoms     SymptomLog[]
  vitals       VitalReading[]
  journal      JournalEntry[]
  sessions     WellnessSession[]
  posts        Post[]
  comments     Comment[]
  likes        PostLike[]
  appointments Appointment[]
}

model MedicalProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  diagnosis        String?
  stage            String?
  diagnosisDate    DateTime?
  treatmentStart   DateTime?
  currentTreatment String?
  medications      String?
  allergies        String?
  emergencyContact String?
  cyclesTotal      Int?
  cyclesCompleted  Int?
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Preferences {
  id                   String  @id @default(cuid())
  userId               String  @unique
  appointmentReminders Boolean @default(true)
  medicationReminders  Boolean @default(true)
  communityUpdates     Boolean @default(false)
  wellnessReminders    Boolean @default(true)
  profileVisible       Boolean @default(true)
  shareProgress        Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Health tracking ─────────────────────────────────────────────────────────

enum Mood {
  GREAT
  GOOD
  OKAY
  LOW
  BAD
}

enum Severity {
  NONE
  MILD
  MODERATE
  SEVERE
}

model DailyLog {
  id           String   @id @default(cuid())
  userId       String
  energy       Int // 1-10
  mood         Mood
  sleepHours   Float?
  waterGlasses Int?
  notes        String?
  loggedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model SymptomLog {
  id       String   @id @default(cuid())
  userId   String
  name     String
  severity Severity
  notes    String?
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model VitalReading {
  id          String   @id @default(cuid())
  userId      String
  temperature Float?
  heartRate   Int?
  systolic    Int?
  diastolic   Int?
  recordedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

// ─── Wellness ────────────────────────────────────────────────────────────────

enum SessionType {
  MEDITATION
  BREATHING
  MUSIC
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  feelings  String
  gratitude String?
  prompt    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WellnessSession {
  id          String      @id @default(cuid())
  userId      String
  type        SessionType
  slug        String
  durationMin Int
  completedAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

// ─── Community ───────────────────────────────────────────────────────────────

enum PostCategory {
  SUPPORT
  QUESTION
  VICTORY
}

model Post {
  id        String       @id @default(cuid())
  authorId  String
  content   String
  category  PostCategory
  createdAt DateTime     @default(now())

  author   User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    PostLike[]

  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

// ─── Consultations ───────────────────────────────────────────────────────────

enum ConsultationMode {
  VIDEO
  PHONE
  CHAT
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model Specialist {
  id              String             @id @default(cuid())
  name            String
  specialty       String
  yearsExperience Int
  priceDzd        Int
  durationMin     Int
  rating          Float
  reviewCount     Int
  modes           ConsultationMode[]
  bio             String?

  appointments Appointment[]
}

model Appointment {
  id           String            @id @default(cuid())
  userId       String
  specialistId String
  mode         ConsultationMode
  startsAt     DateTime
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?
  createdAt    DateTime          @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@index([specialistId, startsAt])
}

// ─── Resources ───────────────────────────────────────────────────────────────

enum ResourceType {
  ARTICLE
  VIDEO
  PDF
}

model Resource {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  summary     String
  description String
  content     String
  type        ResourceType
  minutes     Int
  url         String?
  featured    Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([type])
}
